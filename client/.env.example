# All optional. In development the Vite dev server proxies /api and /socket.io
# to the API, so nothing needs to be set.

# Where the dev server proxies API requests to
VITE_PROXY_TARGET=http://localhost:5000

# Set these only when the API is hosted on a different origin (production)
# VITE_API_URL=https://api.example.com/api/v1
# VITE_SOCKET_URL=https://api.example.com
