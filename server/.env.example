# --- Server ---
NODE_ENV=development
PORT=5000
# URL of the React app (used for CORS and OAuth redirects)
CLIENT_URL=http://localhost:5173
# Public URL of this API (used to build OAuth callback URLs)
SERVER_URL=http://localhost:5000

# --- Database ---
# MongoDB connection string (local or Atlas).
# Leave empty in development to use an embedded MongoDB stored in server/.data
MONGO_URI=

# --- JWT ---
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
# lax | strict | none (use "none" only if client and API are on different sites over HTTPS)
COOKIE_SAMESITE=lax
BCRYPT_ROUNDS=12

# --- Rate limiting on /auth endpoints ---
AUTH_RATE_LIMIT_WINDOW_MIN=15
AUTH_RATE_LIMIT_MAX=20

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
# Authorised redirect URI: http://localhost:5000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Facebook OAuth (https://developers.facebook.com/apps) ---
# Valid OAuth redirect URI: http://localhost:5000/api/v1/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Admin account created automatically on first start ---
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
